extends templates/indexTemp.pug

block main
    form.right(action="/checkSignin",method="post") 
        .enterInfo
            text INFORMACIÓN PERSONAL
            .info
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="NOMBRE",name="name",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CELULAR")
                .inputContainer
                    .inputIcon
                    input(type="email",autocomplete="off",placeholder="CORREO")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="ROL")
        .enterInfo
            text INFORMACIÓN DEL SISTEMA
            .info
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="USUARIO")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CONTRASEÑA")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="PILAR")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CODIGO")
        input(type="submit",class="indexButton",value="SIGN IN") 