extends templates/indexTemp.pug

block main
    form.right(action="/checkSignin",method="post") 
        .enterInfo
            text INFORMACIÓN PERSONAL
            .info
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="TIPO DOCUMENTO",name="idType",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CEDULA",name="id",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="NOMBRE",name="name",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CELULAR",name="phone",required)
                .inputContainer
                    .inputIcon
                    input(type="email",autocomplete="off",placeholder="CORREO",name="email",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="ROL",name="role",required)
        .enterInfo
            text INFORMACIÓN DEL SISTEMA
            .info
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="USUARIO",name="username",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CONTRASEÑA",name="password",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="PILAR",name="pillar",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CODIGO",name="verificationCode",required)
            .buttonContainer        
                input(class="indexButton",value="GENERAR CÓDIGO")
                input(type="submit",class="indexButton",value="SIGN IN") 