extends templates/indexTemp.pug

block main
    script(src="../js/auth.js") 
    form.right(action="/checkSignin",method="post") 
        .enterInfo
            text INFORMACIÓN PERSONAL
            .info
                .inputContainer
                    .inputIcon
                    select(class="selectionBox",name="idType",id="idType", required)
                        option(label="TIPO DOCUMENTO")  
                        hr
                        option(value="TI",label="TARJETA DE IDENTIDAD")
                        option(value="CC",label="CÉDULA DE CIUDADANIA")
                        option(value="TE",label="TARJETA DE EXTRANJERÍA")
                        option(value="CE",label="CÉDULA DE EXTRANJERÍA")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CEDULA",name="id",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="NOMBRE",name="name",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CELULAR",name="phone",required)
                .inputContainer
                    .inputIcon
                    input(type="email",autocomplete="off",placeholder="CORREO",name="email",required)
        .enterInfo
            text INFORMACIÓN DEL SISTEMA
            .info
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="USUARIO",name="username",required)
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CONTRASEÑA",name="password",required)
                .inputContainer
                    .inputIcon
                    select(class="selectionBox",name="pillar",id="pillar", required)
                        option(label="PILAR")  
                        option(value="Crecer",label="CRECER")
                        option(value="Sanar",label="SANAR")
                        option(value="Construir",label="CONSTRUIR")
                        option(value="Mentor",label="MENTOR")
                .inputContainer
                    .inputIcon
                    input(type="text",autocomplete="off",placeholder="CODIGO",name="verificationCode",required)
            .buttonContainer
                input(onclick="generateSecurityCode()" ,class="indexButton",value="GENERAR CÓDIGO")        
                input(type="submit",class="indexButton",value="SIGN IN") 